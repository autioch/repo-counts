{
  "name": "repo-counts",
  "version": "0.3.1",
  "description": "Count the code in your repo(s)",
  "main": "src/index.mjs",
  "bin": "bin/cli.js",
  "type": "module",
  "scripts": {
    "help": "node src/index.mjs -h",
    "ci:lint": "eslint --ext .mjs,.js,.cjs .",
    "ci:test": "mocha ./spec/*.spec.mjs -R min",
    "ci": "npm run ci:lint && npm run ci:test",
    "test": "mocha ./spec/*.spec.mjs -R min",
    "test:config": "node spec/run.mjs",
    "fix:lint": "eslint --ext .mjs,.js,.cjs . --fix",
    "fix": "npm run fix:lint",
    "verify": "npm run fix && npm run ci",
    "postversion": "git push origin HEAD --follow-tags && npm publish"
  },
  "dependencies": {
    "binary-extensions": "2.2.0",
    "commander": "9.0.0",
    "p-limit": "4.0.0",
    "progress": "2.0.3"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.14.7",
    "@babel/plugin-syntax-top-level-await": "7.14.5",
    "eslint": "7.30.0",
    "eslint-config-qb": "1.0.0",
    "eslint-plugin-simple-import-sort": "7.0.0",
    "mocha": "^9.2.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.11.1",
      "onFail": "error"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autioch/repo-counts.git"
  },
  "keywords": [
    "git",
    "counter",
    "repository",
    "report",
    "cloc",
    "loc"
  ],
  "author": "autioch@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/autioch/repo-counts/issues"
  },
  "homepage": "https://github.com/autioch/repo-counts#readme"
}
